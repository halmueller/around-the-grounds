# Crontab for the sites' user (install with `crontab -e` as that user).
# One line per site, hourly, 15 minutes apart and off the top of the hour.
# run.sh also makes sites take turns, so a slow run delays the next site
# rather than overlapping it.
#
# Optional: put each site's healthchecks.io check URL at the start of its
# line, as in the commented example.
7 * * * * $HOME/around-the-grounds/deploy/digitalocean/run.sh seattle-freshies >> $HOME/logs/seattle-freshies.log 2>&1
22 * * * * $HOME/around-the-grounds/deploy/digitalocean/run.sh portland-freshies >> $HOME/logs/portland-freshies.log 2>&1
37 * * * * $HOME/around-the-grounds/deploy/digitalocean/run.sh yakima-freshies >> $HOME/logs/yakima-freshies.log 2>&1
# 7 * * * * HEALTHCHECK_URL=https://hc-ping.com/your-check-uuid $HOME/around-the-grounds/deploy/digitalocean/run.sh seattle-freshies >> $HOME/logs/seattle-freshies.log 2>&1
